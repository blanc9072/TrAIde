# Copy to .env and fill in your own values. Never commit the real .env.

# Database (Postgres connection string, e.g. Supabase)
SUPABASE_URL=

# Reddit (register a script app at reddit.com/prefs/apps) — used by main.py ingestion
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Polygon news API — used by main.py ingestion
POLYGON_API_KEY=

# LLMs
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
